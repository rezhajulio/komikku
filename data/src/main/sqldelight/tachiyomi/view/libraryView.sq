-- NOTE: must update MERGED_SOURCE_ID (6969) here
CREATE VIEW libraryView AS
SELECT
    M.*,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    coalesce(C.latestUpload, 0) AS latestUpload,
    coalesce(C.fetchedAt, 0) AS chapterFetchedAt,
    coalesce(C.lastRead, 0) AS lastRead,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    -- KMK -->
    coalesce(C.bookmarkReadCount, 0) AS bookmarkedReadCount,
    -- KMK <--
    coalesce(MC.categories, '0') AS categories
FROM mangas M
LEFT JOIN (
    SELECT
        chapters.manga_id,
        count(*) AS total,
        sum(read) AS readCount,
        coalesce(max(chapters.date_upload), 0) AS latestUpload,
        coalesce(max(history.last_read), 0) AS lastRead,
        coalesce(max(chapters.date_fetch), 0) AS fetchedAt,
        sum(chapters.bookmark) AS bookmarkCount,
        -- KMK -->
        sum(CASE WHEN chapters.bookmark = 1 AND chapters.read = 1 THEN 1 ELSE 0 END) AS bookmarkReadCount,
        -- KMK <--
        excluded_scanlators.scanlator AS ex_scanlator
    FROM chapters
    LEFT JOIN excluded_scanlators
    ON chapters.manga_id = excluded_scanlators.manga_id
    AND chapters.scanlator = excluded_scanlators.scanlator
    LEFT JOIN history
    ON chapters._id = history.chapter_id
    WHERE ex_scanlator IS NULL
    GROUP BY chapters.manga_id
) AS C
ON M._id = C.manga_id
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM mangas_categories
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M._id
WHERE M.source <> 6969
UNION
SELECT
    M.*,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    coalesce(C.latestUpload, 0) AS latestUpload,
    coalesce(C.fetchedAt, 0) AS chapterFetchedAt,
    coalesce(C.lastRead, 0) AS lastRead,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    -- KMK -->
    coalesce(C.bookmarkReadCount, 0) AS bookmarkedReadCount,
    -- KMK <--
    coalesce(MC.categories, '0') AS categories
FROM mangas M
LEFT JOIN (
    SELECT merged.manga_id,merged.merge_id
    FROM merged
    GROUP BY merged.merge_id
) AS ME
ON ME.merge_id = M._id
LEFT JOIN(
    WITH chapter_data AS (
        SELECT DISTINCT
            chapters.*,
            ME.merge_id,
            ME.chapter_priority,
            MS.chapter_sort_mode
        FROM chapters
        JOIN merged ME
        ON ME.manga_id = chapters.manga_id
        JOIN merged MS
        ON MS.merge_id = ME.merge_id
        AND MS.manga_source = 6969
        LEFT JOIN excluded_scanlators
        ON ME.merge_id = excluded_scanlators.manga_id
        AND chapters.scanlator = excluded_scanlators.scanlator
        WHERE excluded_scanlators.scanlator IS NULL
    ),
    deduped_chapters AS (
        SELECT C.*
        FROM chapter_data C
        WHERE
            C.chapter_sort_mode = 0
            OR (
                C.chapter_sort_mode = 1
                AND (
                    C.chapter_number < 0
                    OR NOT EXISTS (
                        SELECT 1
                        FROM chapter_data D
                        WHERE D.merge_id = C.merge_id
                        AND D.manga_id != C.manga_id
                        AND D.chapter_number = C.chapter_number
                        AND (
                            D.chapter_priority < C.chapter_priority
                            OR (
                                D.chapter_priority = C.chapter_priority
                                AND D.manga_id < C.manga_id
                            )
                        )
                    )
                )
            )
            OR (
                C.chapter_sort_mode = 2
                AND C.manga_id = (
                    SELECT manga_id
                    FROM chapter_data D
                    WHERE D.merge_id = C.merge_id
                    GROUP BY D.merge_id, D.manga_id
                    ORDER BY count(*) DESC, D.manga_id
                    LIMIT 1
                )
            )
            OR (
                C.chapter_sort_mode = 3
                AND C.manga_id = (
                    SELECT D.manga_id
                    FROM chapter_data D
                    WHERE D.merge_id = C.merge_id
                    ORDER BY D.chapter_number DESC, D.manga_id
                    LIMIT 1
                )
            )
    )
    SELECT
        deduped_chapters.merge_id,
        count(*) AS total,
        sum(deduped_chapters.read) AS readCount,
        coalesce(max(deduped_chapters.date_upload), 0) AS latestUpload,
        coalesce(max(history.last_read), 0) AS lastRead,
        coalesce(max(deduped_chapters.date_fetch), 0) AS fetchedAt,
        sum(deduped_chapters.bookmark) AS bookmarkCount,
        -- KMK -->
        sum(CASE WHEN deduped_chapters.bookmark = 1 AND deduped_chapters.read = 1 THEN 1 ELSE 0 END) AS bookmarkReadCount
        -- KMK <--
    FROM deduped_chapters
    LEFT JOIN history
    ON deduped_chapters._id = history.chapter_id
    GROUP BY deduped_chapters.merge_id
) AS C
ON M._id = C.merge_id  -- ON ME.merge_id = C.merge_id
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM mangas_categories
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M._id
WHERE M.source = 6969;

library:
-- KMK -->
-- Replaces `SELECT * FROM libraryView WHERE favorite = 1`, which aggregated every chapter in the
-- database before filtering. `libraryView` above is left as upstream has it, unused, to keep
-- merges simple.
SELECT
    M.*,
    -- `C` only aggregates entries without a cached `manga_chapter_stats` row, so one side is null.
    coalesce(C.total, S.total_count, 0) AS totalCount,
    coalesce(C.readCount, S.read_count, 0) AS readCount,
    coalesce(C.latestUpload, S.latest_upload, 0) AS latestUpload,
    coalesce(C.fetchedAt, S.chapter_fetched_at, 0) AS chapterFetchedAt,
    coalesce(C.lastRead, S.last_read, 0) AS lastRead,
    coalesce(C.bookmarkCount, S.bookmark_count, 0) AS bookmarkCount,
    coalesce(C.bookmarkReadCount, S.bookmark_read_count, 0) AS bookmarkedReadCount,
    coalesce(MC.categories, '0') AS categories
FROM mangas M
LEFT JOIN manga_chapter_stats S
ON S.manga_id = M._id
LEFT JOIN (
    SELECT
        chapters.manga_id,
        count(*) AS total,
        sum(read) AS readCount,
        coalesce(max(chapters.date_upload), 0) AS latestUpload,
        coalesce(max(history.last_read), 0) AS lastRead,
        coalesce(max(chapters.date_fetch), 0) AS fetchedAt,
        sum(chapters.bookmark) AS bookmarkCount,
        sum(CASE WHEN chapters.bookmark = 1 AND chapters.read = 1 THEN 1 ELSE 0 END) AS bookmarkReadCount,
        excluded_scanlators.scanlator AS ex_scanlator
    FROM chapters
    LEFT JOIN excluded_scanlators
    ON chapters.manga_id = excluded_scanlators.manga_id
    AND chapters.scanlator = excluded_scanlators.scanlator
    LEFT JOIN history
    ON chapters._id = history.chapter_id
    WHERE ex_scanlator IS NULL
    -- Aggregate only the entries this query returns; `IN` beats a join for the small favourite list.
    AND chapters.manga_id IN (
        SELECT _id FROM mangas WHERE favorite = 1
        -- Skip entries with cached aggregates.
        AND _id NOT IN (SELECT manga_id FROM manga_chapter_stats)
    )
    GROUP BY chapters.manga_id
) AS C
ON M._id = C.manga_id
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM mangas_categories
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M._id
WHERE M.favorite = 1 AND M.source <> 6969

UNION ALL

-- Merged entries aggregate their children's chapters live.
SELECT
    M.*,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    coalesce(C.latestUpload, 0) AS latestUpload,
    coalesce(C.fetchedAt, 0) AS chapterFetchedAt,
    coalesce(C.lastRead, 0) AS lastRead,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    coalesce(C.bookmarkReadCount, 0) AS bookmarkedReadCount,
    coalesce(MC.categories, '0') AS categories
FROM mangas M
LEFT JOIN (
    -- Same merged-entry dedup as libraryView above, restricted to this query's entries.
    WITH chapter_data AS (
        SELECT DISTINCT
            chapters.*,
            ME.merge_id,
            ME.chapter_priority,
            MS.chapter_sort_mode
        FROM chapters
        JOIN merged ME
        ON ME.manga_id = chapters.manga_id
        JOIN merged MS
        ON MS.merge_id = ME.merge_id
        AND MS.manga_source = 6969
        LEFT JOIN excluded_scanlators
        ON ME.merge_id = excluded_scanlators.manga_id
        AND chapters.scanlator = excluded_scanlators.scanlator
        WHERE excluded_scanlators.scanlator IS NULL
        -- Aggregate only the entries this query returns.
        AND ME.merge_id IN (SELECT _id FROM mangas WHERE favorite = 1)
    ),
    deduped_chapters AS (
        SELECT C.*
        FROM chapter_data C
        WHERE
            C.chapter_sort_mode = 0
            OR (
                C.chapter_sort_mode = 1
                AND (
                    C.chapter_number < 0
                    OR NOT EXISTS (
                        SELECT 1
                        FROM chapter_data D
                        WHERE D.merge_id = C.merge_id
                        AND D.manga_id != C.manga_id
                        AND D.chapter_number = C.chapter_number
                        AND (
                            D.chapter_priority < C.chapter_priority
                            OR (
                                D.chapter_priority = C.chapter_priority
                                AND D.manga_id < C.manga_id
                            )
                        )
                    )
                )
            )
            OR (
                C.chapter_sort_mode = 2
                AND C.manga_id = (
                    SELECT manga_id
                    FROM chapter_data D
                    WHERE D.merge_id = C.merge_id
                    GROUP BY D.merge_id, D.manga_id
                    ORDER BY count(*) DESC, D.manga_id
                    LIMIT 1
                )
            )
            OR (
                C.chapter_sort_mode = 3
                AND C.manga_id = (
                    SELECT D.manga_id
                    FROM chapter_data D
                    WHERE D.merge_id = C.merge_id
                    ORDER BY D.chapter_number DESC, D.manga_id
                    LIMIT 1
                )
            )
    )
    SELECT
        deduped_chapters.merge_id,
        count(*) AS total,
        sum(deduped_chapters.read) AS readCount,
        coalesce(max(deduped_chapters.date_upload), 0) AS latestUpload,
        coalesce(max(history.last_read), 0) AS lastRead,
        coalesce(max(deduped_chapters.date_fetch), 0) AS fetchedAt,
        sum(deduped_chapters.bookmark) AS bookmarkCount,
        sum(CASE WHEN deduped_chapters.bookmark = 1 AND deduped_chapters.read = 1 THEN 1 ELSE 0 END) AS bookmarkReadCount
    FROM deduped_chapters
    LEFT JOIN history
    ON deduped_chapters._id = history.chapter_id
    GROUP BY deduped_chapters.merge_id
) AS C
ON M._id = C.merge_id
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM mangas_categories
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M._id
WHERE M.favorite = 1 AND M.source = 6969;
-- KMK <--

readMangaNonLibrary:
-- KMK -->
SELECT
    M.*,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    coalesce(C.latestUpload, 0) AS latestUpload,
    coalesce(C.fetchedAt, 0) AS chapterFetchedAt,
    coalesce(C.lastRead, 0) AS lastRead,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    coalesce(C.bookmarkReadCount, 0) AS bookmarkedReadCount,
    coalesce(MC.categories, '0') AS categories
FROM mangas M
LEFT JOIN (
    SELECT
        chapters.manga_id,
        count(*) AS total,
        sum(read) AS readCount,
        coalesce(max(chapters.date_upload), 0) AS latestUpload,
        coalesce(max(history.last_read), 0) AS lastRead,
        coalesce(max(chapters.date_fetch), 0) AS fetchedAt,
        sum(chapters.bookmark) AS bookmarkCount,
        sum(CASE WHEN chapters.bookmark = 1 AND chapters.read = 1 THEN 1 ELSE 0 END) AS bookmarkReadCount,
        excluded_scanlators.scanlator AS ex_scanlator
    FROM chapters
    -- Aggregate only the entries this query returns.
    JOIN mangas MF
    ON MF._id = chapters.manga_id
    AND MF.favorite = 0
    LEFT JOIN excluded_scanlators
    ON chapters.manga_id = excluded_scanlators.manga_id
    AND chapters.scanlator = excluded_scanlators.scanlator
    LEFT JOIN history
    ON chapters._id = history.chapter_id
    WHERE ex_scanlator IS NULL
    GROUP BY chapters.manga_id
) AS C
ON M._id = C.manga_id
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM mangas_categories
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M._id
WHERE M.favorite = 0 AND M.source <> 6969 AND coalesce(C.readCount, 0) != 0

UNION ALL

-- Merged entries aggregate their children's chapters live.
SELECT
    M.*,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    coalesce(C.latestUpload, 0) AS latestUpload,
    coalesce(C.fetchedAt, 0) AS chapterFetchedAt,
    coalesce(C.lastRead, 0) AS lastRead,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    coalesce(C.bookmarkReadCount, 0) AS bookmarkedReadCount,
    coalesce(MC.categories, '0') AS categories
FROM mangas M
LEFT JOIN (
    -- Same merged-entry dedup as libraryView above, restricted to this query's entries.
    WITH chapter_data AS (
        SELECT DISTINCT
            chapters.*,
            ME.merge_id,
            ME.chapter_priority,
            MS.chapter_sort_mode
        FROM chapters
        JOIN merged ME
        ON ME.manga_id = chapters.manga_id
        JOIN merged MS
        ON MS.merge_id = ME.merge_id
        AND MS.manga_source = 6969
        LEFT JOIN excluded_scanlators
        ON ME.merge_id = excluded_scanlators.manga_id
        AND chapters.scanlator = excluded_scanlators.scanlator
        WHERE excluded_scanlators.scanlator IS NULL
        -- Aggregate only the entries this query returns.
        AND ME.merge_id IN (SELECT _id FROM mangas WHERE favorite = 0)
    ),
    deduped_chapters AS (
        SELECT C.*
        FROM chapter_data C
        WHERE
            C.chapter_sort_mode = 0
            OR (
                C.chapter_sort_mode = 1
                AND (
                    C.chapter_number < 0
                    OR NOT EXISTS (
                        SELECT 1
                        FROM chapter_data D
                        WHERE D.merge_id = C.merge_id
                        AND D.manga_id != C.manga_id
                        AND D.chapter_number = C.chapter_number
                        AND (
                            D.chapter_priority < C.chapter_priority
                            OR (
                                D.chapter_priority = C.chapter_priority
                                AND D.manga_id < C.manga_id
                            )
                        )
                    )
                )
            )
            OR (
                C.chapter_sort_mode = 2
                AND C.manga_id = (
                    SELECT manga_id
                    FROM chapter_data D
                    WHERE D.merge_id = C.merge_id
                    GROUP BY D.merge_id, D.manga_id
                    ORDER BY count(*) DESC, D.manga_id
                    LIMIT 1
                )
            )
            OR (
                C.chapter_sort_mode = 3
                AND C.manga_id = (
                    SELECT D.manga_id
                    FROM chapter_data D
                    WHERE D.merge_id = C.merge_id
                    ORDER BY D.chapter_number DESC, D.manga_id
                    LIMIT 1
                )
            )
    )
    SELECT
        deduped_chapters.merge_id,
        count(*) AS total,
        sum(deduped_chapters.read) AS readCount,
        coalesce(max(deduped_chapters.date_upload), 0) AS latestUpload,
        coalesce(max(history.last_read), 0) AS lastRead,
        coalesce(max(deduped_chapters.date_fetch), 0) AS fetchedAt,
        sum(deduped_chapters.bookmark) AS bookmarkCount,
        sum(CASE WHEN deduped_chapters.bookmark = 1 AND deduped_chapters.read = 1 THEN 1 ELSE 0 END) AS bookmarkReadCount
    FROM deduped_chapters
    LEFT JOIN history
    ON deduped_chapters._id = history.chapter_id
    GROUP BY deduped_chapters.merge_id
) AS C
ON M._id = C.merge_id
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM mangas_categories
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M._id
WHERE M.favorite = 0 AND M.source = 6969 AND coalesce(C.readCount, 0) != 0;
